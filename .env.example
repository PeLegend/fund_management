# Database
POSTGRES_DB=fund_db
POSTGRES_USER=fund_user
POSTGRES_PASSWORD=fund_pass

# Backend
DATABASE_URL=postgres://fund_user:fund_pass@db:5432/fund_db
PORT=3001
JWT_SECRET=your_jwt_secret_here

ORDER_PROCESSING_DELAY=2000
ORDER_COMPLETION_DELAY=5000

# AI Chatbot (OpenAI-compatible)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# Frontend
VITE_API_URL=http://localhost:3001

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@fund.com
PGADMIN_DEFAULT_PASSWORD=admin
